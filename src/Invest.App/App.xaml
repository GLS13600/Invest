<Application x:Class="Invest.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Invest.App.Converters"
             xmlns:vm="clr-namespace:Invest.App.ViewModels"
             xmlns:views="clr-namespace:Invest.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Convertisseurs -->
            <conv:CurrencyConverter x:Key="Currency" />
            <conv:SignedCurrencyConverter x:Key="SignedCurrency" />
            <conv:PercentConverter x:Key="Percent" />
            <conv:SignToBrushConverter x:Key="SignToBrush" />

            <!-- Câblage automatique ViewModel -> View -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReelViewModel}">
                <views:ReelView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SimulationViewModel}">
                <views:SimulationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PeaViewModel}">
                <views:PeaView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BudgetViewModel}">
                <views:BudgetView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
