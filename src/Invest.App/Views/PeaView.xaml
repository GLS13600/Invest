<UserControl x:Class="Invest.App.Views.PeaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Fiscalité PEA" Style="{StaticResource H2}" FontSize="26" Margin="0,0,0,18" />

        <!-- Compte à rebours des 5 ans -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
            <StackPanel>
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="TEMPS AVANT EXONÉRATION D'IMPÔT" Style="{StaticResource Muted}"
                                   FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource H1}" FontSize="44"
                                       Text="{Binding DaysRemaining}" />
                            <TextBlock Text="jours" Style="{StaticResource Muted}" FontSize="18"
                                       VerticalAlignment="Bottom" Margin="10,0,0,10" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Style="{StaticResource Muted}"
                               Text="{Binding MaturityDate, StringFormat='5 ans atteints le {0:dd/MM/yyyy}'}" />
                </DockPanel>

                <!-- Jauge de progression -->
                <Border Background="{StaticResource Surface2Brush}" CornerRadius="6" Height="12"
                        Margin="0,18,0,8">
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource AccentBrush}">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid>
                                    <Border x:Name="PART_Track" />
                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                            Background="{StaticResource AccentBrush}" CornerRadius="6" />
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </Border>

                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Simulateur de retrait -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Simulateur de retrait" Style="{StaticResource H2}" Margin="0,0,0,14" />
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Plus-value retirée (€)" Style="{StaticResource Muted}" />
                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold"
                               Text="{Binding WithdrawalGain, StringFormat={}{0:N0} €}" />
                </DockPanel>
                <Slider Minimum="0" Maximum="50000" Value="{Binding WithdrawalGain}"
                        TickFrequency="500" Margin="0,0,0,18" />

                <UniformGrid Columns="3">
                    <StackPanel>
                        <TextBlock Text="Taux appliqué" Style="{StaticResource Muted}" />
                        <TextBlock Style="{StaticResource H2}" Margin="0,4,0,0" Text="{Binding TaxRateText}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Impôt estimé" Style="{StaticResource Muted}" />
                        <TextBlock Style="{StaticResource H2}" Margin="0,4,0,0" Foreground="{StaticResource RedBrush}"
                                   Text="{Binding EstimatedTax, Converter={StaticResource Currency}}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Net après impôt" Style="{StaticResource Muted}" />
                        <TextBlock Style="{StaticResource H2}" Margin="0,4,0,0" Foreground="{StaticResource GreenBrush}"
                                   Text="{Binding NetAfterTax, Converter={StaticResource Currency}}" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
